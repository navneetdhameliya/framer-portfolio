# Production settings, read by Next.js when Vercel builds the site.
# Only public, non-secret values belong here (this file is committed).

# Public address of the site, no trailing slash. Used for full URLs in page
# metadata (e.g. link previews when the site is shared).
# Change this to your custom domain once it is connected in Vercel.
NEXT_PUBLIC_SITE_URL=https://framer-portfolio.vercel.app

# Gmail account the contact form sends from (and to). Not secret.
GMAIL_USER=artonest.design@gmail.com
# GMAIL_APP_PASSWORD is a SECRET: never put it in this file. Set it in
# Vercel → Project → Settings → Environment Variables, and in .env.local locally.
